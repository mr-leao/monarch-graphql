MONARCH_EMAIL=
MONARCH_PASSWORD=

# Optional. The "Two-factor text code" from Monarch Settings > Security.
# Leave blank to be prompted for an authenticator code instead.
MONARCH_MFA_SECRET=

# Optional. One-time code from the Monarch login email. Leave blank to be prompted.
# This is separate from the authenticator code.
MONARCH_EMAIL_OTP=

# Optional. Full browser Cookie header if password login is blocked by CAPTCHA.
# Must include both session_id and csrftoken.
# MONARCH_COOKIE=
